# Same Supabase project as the museum and the admin app. This tool signs
# in as an ordinary user and RLS decides what it may do -- there is
# deliberately NO service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never give it a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
# Optional: the model used when a chain names none.
# GEMINI_MODEL=gemini-flash-latest
